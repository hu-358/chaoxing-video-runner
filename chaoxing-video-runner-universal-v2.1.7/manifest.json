{
  "manifest_version": 3,
  "name": "学习通课程任务播放器（通用版）",
  "version": "2.1.7",
  "description": "支持后台生命周期恢复，扫描学习通课程并真实播放视频、处理官方PDF、PPT和Word任务点。",
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://*.chaoxing.com/*",
    "http://*.chaoxing.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.chaoxing.com/mycourse/studentstudy*",
        "http://*.chaoxing.com/mycourse/studentstudy*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.chaoxing.com/*",
        "http://*.chaoxing.com/*"
      ],
      "js": [
        "portal.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.chaoxing.com/ananas/modules/pdf/index.html*",
        "http://*.chaoxing.com/ananas/modules/pdf/index.html*"
      ],
      "js": [
        "document-viewer.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
